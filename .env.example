# Convex backend URL (used by the frontend at build time)
VITE_CONVEX_URL=https://kindhearted-lark-661.convex.cloud

# Optional: canonical site origin for copied iframe embed code (defaults to current origin in dev)
# VITE_PUBLIC_SITE_URL=https://www.thesynlab.com

# Google Tag Manager container ID (GTM-XXXX). When set, only GTM loads (add Ahrefs Custom HTML + GA4 there).
# When unset, the app loads Ahrefs + direct GA4 below (no GTM).
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# GA4 Measurement ID — the ONE property TheSynLab reports into (property 531573397).
#
# AN-1: this value is the single source of truth. `injectGa4Plugin` in
# vite.config.ts substitutes it into index.html's %VITE_GA4_MEASUREMENT_ID% token
# at build time, and src/lib/analytics.ts uses the same value for events.
# Never hardcode an ID in index.html and never add a second ID anywhere: that
# creates a second GA4 property, and the two reports will never reconcile with
# each other or with Search Console.
# See docs/ANALYTICS_GSC_GA4_RECONCILIATION.md.
VITE_GA4_MEASUREMENT_ID=G-NC8K7M5LRX

# --- Passive revenue (optional build-time) ---
# Amazon Associates store ID / tag (appends ?tag= on amazon.* outbound product links).
# VITE_AMAZON_ASSOCIATES_TAG=yourstore-20

# Google AdSense: publisher client ca-pub-xxx and per-ad-unit slot IDs (matches AdSlot slotName keys).
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_REVIEW_SIDEBAR=1234567890
# VITE_ADSENSE_SLOT_HOME_LEADERBOARD=1234567890
# VITE_ADSENSE_SLOT_COMPARE_INLINE=1234567890
# VITE_ADSENSE_SLOT_COMPARE_SIDEBAR=1234567890
# When Convex adSlotConfigs are empty, set to 1 to still render AdSense from env only.
# VITE_ADSENSE_FALLBACK_WITHOUT_DB=1
# Ad slot ids for the hub hero and forum in-article units.
# VITE_ADSENSE_SLOT_HUB_HERO_BELOW=1234567890
# VITE_ADSENSE_SLOT_FORUM_IN_ARTICLE_1=1234567890

# --- Adnium (second ad network — see src/lib/adnium.ts + docs/ADNIUM_INTEGRATION.md) ---
# Publisher key from adn_verify.txt. Public value, safe to commit; also emitted as a
# site-verification meta tag in index.html. Rotate here if Adnium issues a new key.
# VITE_ADNIUM_SITE_KEY=ADN55c88d9c53ef4
# VITE_ADNIUM_ENABLED=1
# VITE_ADNIUM_POPUNDER=1
# Shared zone parameters — copy from Adnium → Zones → Get code.
# VITE_ADNIUM_ZONE_PID=1333
# VITE_ADNIUM_ZONE_SID=573
# 1 banner · 2 interstitial · 3 in-page push · 4 popunder
# VITE_ADNIUM_ZONE_TYPE=4
# Zone type for the in-slot backfill units (default 1 = banner; 3 = in-page push).
# VITE_ADNIUM_SLOT_TYPE=1
# Site-wide popunder zone id. Empty ⇒ no popunder tag is injected.
# VITE_ADNIUM_ZONE_ID=
# Adnium trigger classes: popunders only fire for clicks on these non-navigation CSS
# classes (Adnium's documented way to stay Google/AdSense compliant).
# VITE_ADNIUM_TRIGGER_CLASSES=article-body review-card product-thumb
# Optional: paste the exact Adnium tag URL to override the built-in popunder endpoint.
# Placeholders: {id} {pid} {sid} {type} {width} {height} {key} {random}
# VITE_ADNIUM_TAG_URL=
# In-slot Adnium zones (mirror the AdSense slot map; Adnium backfills unfilled slots).
# VITE_ADNIUM_SLOT_REVIEW_SIDEBAR=
# VITE_ADNIUM_SLOT_HOME_LEADERBOARD=
# VITE_ADNIUM_SLOT_COMPARE_INLINE=
# VITE_ADNIUM_SLOT_COMPARE_SIDEBAR=
# VITE_ADNIUM_SLOT_HUB_HERO_BELOW=
# VITE_ADNIUM_SLOT_FORUM_IN_ARTICLE_1=

# --- Adsterra (native banner + display banners + popunder) — see src/lib/adsterra.ts ---
# Native Banner renders into <div id="container-<KEY>"> and loads <KEY>/invoke.js lazily.
# VITE_ADSTERRA_ENABLED=1
# VITE_ADSTERRA_NATIVE_KEY=6c361a6751ca12f38bc29d1189826773
# VITE_ADSTERRA_NATIVE_SRC=https://pl31590134.profitableratecpmnetwork.com/6c361a6751ca12f38bc29d1189826773/invoke.js
# Popunder tag: one per document load, after advertising consent, content routes only.
# VITE_ADSTERRA_POPUNDER=1
# VITE_ADSTERRA_POPUNDER_SRC=https://pl31589899.profitableratecpmnetwork.com/43/2b/19/432b19cb46f5e384280a7ece2773593a.js
# Optional: extra Native Banners on the same account, one per slot (key only; the loader
# URL is derived by swapping the key segment). Add _SRC when the banner lives on another host.
# VITE_ADSTERRA_SLOT_REVIEW_SIDEBAR=
# VITE_ADSTERRA_SLOT_HOME_LEADERBOARD=
# VITE_ADSTERRA_SLOT_COMPARE_INLINE=
# VITE_ADSTERRA_SLOT_COMPARE_SIDEBAR=
# VITE_ADSTERRA_SLOT_HUB_HERO_BELOW=
# VITE_ADSTERRA_SLOT_FORUM_IN_ARTICLE_1=
# Per-slot format preference: auto (default) prefers the banner when its size matches the
# slot, "banner" forces the Display Banner, "native" forces the Native Banner div.
# VITE_ADSTERRA_SLOT_REVIEW_SIDEBAR_PREFER=
# Display Banners (atOptions + invoke.js, sandboxed per slot in an srcdoc iframe).
# Units verified in Adsterra dashboard: 31489400 (300x250), 31489635 (728x90).
# VITE_ADSTERRA_BANNER_SRC=https://www.highperformanceformat.com
# VITE_ADSTERRA_BANNER_300X250_KEY=31489400
# VITE_ADSTERRA_BANNER_300X250_WIDTH=300
# VITE_ADSTERRA_BANNER_300X250_HEIGHT=250
# VITE_ADSTERRA_BANNER_728X90_KEY=31489635
# VITE_ADSTERRA_BANNER_728X90_WIDTH=728
# VITE_ADSTERRA_BANNER_728X90_HEIGHT=90
# Optional: pin an explicit Display Banner key per slot (+ _WIDTH/_HEIGHT/_SRC).
# VITE_ADSTERRA_BANNER_SLOT_REVIEW_SIDEBAR=
# VITE_ADSTERRA_BANNER_SLOT_HOME_LEADERBOARD=
# VITE_ADSTERRA_BANNER_SLOT_COMPARE_INLINE=
# VITE_ADSTERRA_BANNER_SLOT_COMPARE_SIDEBAR=
# VITE_ADSTERRA_BANNER_SLOT_HUB_HERO_BELOW=
# VITE_ADSTERRA_BANNER_SLOT_FORUM_IN_ARTICLE_1=

# Which network owns the popunder: adsterra | adnium | both | none.
# Never run two popunder tags: the same click would open two windows.
# VITE_POPUNDER_NETWORK=adsterra

# --- Ad placement efficiency ---
# Max paid ad units rendered per pageview (frequency/viewability cap). Default 4.
# VITE_AD_UNITS_PER_PAGE=4
# "1" renders reserved-slot placeholders in production builds (debug only).
# VITE_ADS_DEBUG_PLACEHOLDERS=

# Convex deployment key - for CLI only (npx convex dev / npx convex deploy).
# Get from: https://dashboard.convex.dev → your deployment → Settings
CONVEX_DEPLOY_KEY=dev:kindhearted-lark-661|eyJ2MiI6IjYwODUwYWVjMGMwOTQ2YTU4ZTVmMWZhZjYxZDc3ZmVhIn0=

# =============================================================================
# FREE TIER – No API keys required. Works out of the box at $0/month.
# =============================================================================

# --- ML Predictions (S1) ---
# FREE: Uses built-in heuristic when unset. No key needed.
# PAID: Optional ML_API_URL for external XGBoost/FastAPI service.
# ML_API_URL=

# --- Blockchain (S3) ---
# FREE: Simulated deterministic verification when unset. No key needed.
# PAID: Alchemy free tier (30M CUs/month) – sign up at alchemy.com
# ALCHEMY_API_KEY=
# ALCHEMY_API_URL=https://polygon-mainnet.g.alchemy.com/v2
# ALCHEMY_FROM_ADDRESS=

# --- Translation (S9) ---
# FREE: MyMemory API (no key). Optional MYMEMORY_EMAIL for higher daily limit.
# PAID: ANTHROPIC_API_KEY for Claude (higher quality, paid).
# MYMEMORY_EMAIL=
# ANTHROPIC_API_KEY=

# --- Affiliate Prices (S10) ---
# FREE: Uses product base price + variance when unset. No key needed.
# PAID: AFFILIATE_PRICE_API_URL for live price fetches.
# AFFILIATE_PRICE_API_URL=

VITE_FACEBOOK_PIXEL_ID=your_pixel_id_here

# ════════════════════════════════════════════════════════════════════════════
# AI / NVIDIA NIM API (OpenAI-compatible inference)
# ════════════════════════════════════════════════════════════════════════════
# Get a key at: https://build.nvidia.com/explore/discover
# Used by: AICompareAssistant for product comparison answers
VITE_NVIDIA_API_KEY=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

# NVIDIA model to use (default: meta/llama-3.1-70b-instruct — best quality)
# Options: meta/llama-3.1-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct, mistralai/mistral-7b-instruct-v0.3
VITE_NVIDIA_MODEL=meta/llama-3.1-70b-instruct
